{
  "manifest_version": 3,
  "version": "1.1",
  "name": "Send with Ctrl+Enter in Discord / Muse / Claude / Gemini",
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*",
        "https://muse.ai/*",
        "https://*.muse.ai/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "script.js"
      ]
    }
  ],
  "permissions": [
    "activeTab"
  ]
}
