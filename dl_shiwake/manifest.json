{
  "manifest_version": 3,
  "name": "ダウンロード先振り分け",
  "version": "1.0.3",
  "description": "ダウンロードしたファイルをURL・拡張子ルールに基づいてフォルダ分け保存します。ダウンロードしたファイルのURL、もしくはダウンロード元のURL（リファラー）を参照します（ドメインでなくフルURLでマッチ（部分一致）します）",
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": [
    "downloads",
    "storage"
  ]
}